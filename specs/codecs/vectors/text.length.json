{
  "codec": "text.length",
  "version": 1,
  "cases": [
    {
      "name": "min-ok",
      "params": {
        "min": 1,
        "max": 3
      },
      "input": "a",
      "expect": "a"
    },
    {
      "name": "max-ok",
      "params": {
        "min": 1,
        "max": 3
      },
      "input": "abc",
      "expect": "abc"
    },
    {
      "name": "too-long",
      "params": {
        "min": 1,
        "max": 3
      },
      "input": "abcd",
      "error": "LengthOutOfRange"
    },
    {
      "name": "empty-below-min",
      "params": {
        "min": 1,
        "max": 3
      },
      "input": "",
      "error": "LengthOutOfRange"
    },
    {
      "name": "counts-code-points-not-utf16",
      "params": {
        "min": 1,
        "max": 1
      },
      "input": "\ud83d\ude00",
      "expect": "\ud83d\ude00"
    },
    {
      "name": "counts-code-points-not-graphemes-after-nfc",
      "params": {
        "min": 1,
        "max": 1
      },
      "input": "q\u0301",
      "error": "LengthOutOfRange"
    },
    {
      "name": "max-only",
      "params": {
        "max": 2
      },
      "input": "",
      "expect": ""
    }
  ]
}
