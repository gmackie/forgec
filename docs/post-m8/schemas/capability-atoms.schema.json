{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge:plan:capability-atoms:1",
  "title": "Illustrative flattened capability atom set",
  "type": "object",
  "required": [
    "resource",
    "purpose",
    "allow",
    "deny"
  ],
  "additionalProperties": false,
  "properties": {
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "allow": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/atom"
      }
    },
    "deny": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/atom"
      }
    }
  },
  "$defs": {
    "atom": {
      "type": "object",
      "required": [
        "verb",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "verb": {
          "enum": [
            "read",
            "create",
            "update",
            "filter",
            "order",
            "aggregate",
            "expand",
            "export",
            "actions"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
