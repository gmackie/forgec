resource Claim { id : id }
resource ClaimDecision { id : id }
resource Coverage { id : id }
resource Evidence { id : id }
resource Payout { id : id }
function AssessClaim @http(POST, "/realization-b/AssessClaim") { input Claim.Record
 output ClaimDecision.Record }
function MaintainClaim @http(POST, "/realization-b/MaintainClaim") { input Claim.Record
 output Claim.Record }
function MaintainCoverage @http(POST, "/realization-b/MaintainCoverage") { input Claim.Record
 output Coverage.Record }
function PayClaim @http(POST, "/realization-b/PayClaim") { input Claim.Record
 output Payout.Record }
function ReceiveEvidence @http(POST, "/realization-b/ReceiveEvidence") { input Claim.Record
 output Evidence.Record }
function ReopenClaim @http(POST, "/realization-b/ReopenClaim") { input Claim.Record
 output Claim.Record }
function ReportLoss @http(POST, "/realization-b/ReportLoss") { input Claim.Record
 output Claim.Record }
function ScreenFraud @http(POST, "/realization-b/ScreenFraud") { input Claim.Record
 output Claim.Record }
