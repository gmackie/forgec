resource Batch { id : id }
resource Machine { id : id }
resource MaintenanceOrder { id : id }
resource QualityHold { id : id }
resource TemperatureWindow { id : id }
function CalculateTemperatureWindow @http(POST, "/realization-b/CalculateTemperatureWindow") { input Batch.Record
 output TemperatureWindow.Record }
function DetectExcursion @http(POST, "/realization-b/DetectExcursion") { input Batch.Record
 output QualityHold.Record }
function MaintainEquipment @http(POST, "/realization-b/MaintainEquipment") { input Batch.Record
 output MaintenanceOrder.Record }
function MaintainMachine @http(POST, "/realization-b/MaintainMachine") { input Batch.Record
 output Machine.Record }
function ReceiveTelemetry @http(POST, "/realization-b/ReceiveTelemetry") { input Batch.Record
 output Batch.Record }
function TrackBatch @http(POST, "/realization-b/TrackBatch") { input Batch.Record
 output Batch.Record }
