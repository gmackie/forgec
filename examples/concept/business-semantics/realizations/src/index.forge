resource Balance
  @timestamps
  @effectiveDated(uniqueBy: [account])
{
  id : id
  account : text
  amount : decimal<6>
  applied : decimal<6>
  list by account
    order by effectiveFrom asc
  rules {
    applied <= amount
  }
}
channel Movements {
  delivery at-least-once
  message Transfer {
    id : id
    occurredAt : datetime
    knownAt : datetime
  }
  message Applied {
    cause : Movements.Transfer
    target : Balance
    quantity : decimal<6>
    validFrom : datetime
    knownFrom : datetime
  }
}
