export resource Integration @tenant @versioned {
  id : id
  provider : text length 1..50
  accessToken : text length 1..4096 @secret
  refreshToken : text? length <= 4096 @secret
  list by provider
}
export resource DeploymentCredential @tenant @versioned {
  id : id
  name : text length 1..100
  token : text length 1..4096 @secret
  unique name
  find by name
}
