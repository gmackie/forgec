{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "forge-acme",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": { "FORGE_AUTH": "dev-headers" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forge-acme",
      "database_id": "REPLACED_AT_PROVISION",
      "migrations_dir": "../../generated/d1"
    }
  ]
}
