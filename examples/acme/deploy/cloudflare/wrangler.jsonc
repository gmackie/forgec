{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "forge-acme",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": { "FORGE_AUTH": "dev-headers", "FORGE_CORS": "http://localhost:5173,https://forge-acme-workspace.example.workers.dev" },
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "forge-acme-blobs" }],
  // Crons: the 5-minute outbox/workflow sweep plus every schedule's exact UTC cron (bundle.schedules.cloudflareCrons).
  "triggers": { "crons": ["*/5 * * * *", "0 3 * * *"] },
  "durable_objects": { "bindings": [{ "name": "REALTIME", "class_name": "ForgeRealtime" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ForgeRealtime"] }],
  "workflows": [{ "name": "forge-acme-commerce-process-order", "binding": "WF_PROCESS_ORDER", "class_name": "ProcessOrderWorkflow" }],
  "queues": {
    "producers": [{ "binding": "Q_FULFILL_ORDER", "queue": "forge-acme-commerce-fulfill-order" }],
    "consumers": [{ "queue": "forge-acme-commerce-fulfill-order", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "forge-acme-commerce-dlq" }]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forge-acme",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations/d1"
    }
  ]
}
