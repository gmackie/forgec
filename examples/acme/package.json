{
  "name": "@acme/commerce-deploy",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cargo run -q -p forgegraph-cli -- build .",
    "cf:dev": "CFG=$(node deploy/cloudflare/resolve-config.mjs) && wrangler dev --config \"$CFG\" --port 8797",
    "cf:migrate:local": "CFG=$(node deploy/cloudflare/resolve-config.mjs) && wrangler d1 migrations apply forge-acme --local --config \"$CFG\"",
    "cf:migrate:remote": "CFG=$(node deploy/cloudflare/resolve-config.mjs) && wrangler d1 migrations apply forge-acme --remote --config \"$CFG\"",
    "cf:deploy": "CFG=$(node deploy/cloudflare/resolve-config.mjs) && wrangler deploy --config \"$CFG\"",
    "aws:bundle": "node deploy/aws/bundle.mjs",
    "aws:synth": "pnpm aws:bundle && cdk synth --app 'node --experimental-strip-types deploy/aws/app.ts' --output deploy/aws/cdk.out",
    "aws:deploy": "pnpm aws:bundle && cdk deploy --app 'node --experimental-strip-types deploy/aws/app.ts' --output deploy/aws/cdk.out --require-approval never --outputs-file deploy/aws/outputs.json",
    "aws:destroy": "cdk destroy --app 'node --experimental-strip-types deploy/aws/app.ts' --output deploy/aws/cdk.out --force",
    "workspace:dev": "vite",
    "workspace:build": "vite build",
    "workspace:deploy": "pnpm workspace:build && wrangler deploy --config deploy/cloudflare/workspace.wrangler.jsonc",
    "node:serve": "pnpm node:bundle && node deploy/node/dist/server.mjs",
    "pg:migrate": "psql \"$FORGE_PG_URL\" -v ON_ERROR_STOP=1 -f migrations/postgres/0001_init.sql",
    "node:bundle": "node deploy/node/bundle.mjs",
    "cf:config": "node deploy/cloudflare/resolve-config.mjs"
  },
  "dependencies": {
    "@forgegraph/runtime": "workspace:*",
    "effect": "4.0.0-rc.116",
    "@aws-sdk/client-dynamodb": "^3.1136.0",
    "@aws-sdk/lib-dynamodb": "^3.1136.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@forgegraph/react": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "pg": "^8",
    "ws": "^8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250920.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.83.0",
    "aws-cdk": "^2.1142.0",
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.4.0",
    "esbuild": "^0.27.0",
    "@types/node": "^24.0.0",
    "vite": "^8.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
