export resource Issue @tenant @versioned {
  id : id
  project : text length 1..64
  number : integer @sequence(partition: project, start: 1, max: 1000000)
  title : text length 1..200
  unique project, number
  find by project, number
}
export resource Ticket @tenant @versioned {
  id : id
  number : integer @sequence(start: 100, max: 102)
  title : text length 1..200
  unique number
}
