// Illustrates subject links; not a FERPA/COPPA compliance template.
purpose AttendanceOperations

enum AttendanceStatus {
  Present
  Absent
  Excused
}

export resource Guardian
  @tenant
  @timestamps
  @versioned
  @subject(person)
{
  id : id
  name : text length 1..200 @data(data.identity.name)
  email : email
}

export resource Student
  @tenant
  @timestamps
  @versioned
  @subject(person)
  @record(education)
{
  id : id
  name : text length 1..200 @data(data.identity.name)
  guardian : Guardian

  list by guardian
    order by name asc
}

/// Student erasure does not automatically delete Guardian or other students' data.
export resource AttendanceRecord
  @tenant
  @timestamps
  @versioned
  @subject(from: student)
  @record(education)
{
  id : id
  student : Student
  date : date
  status : AttendanceStatus
  healthNote : text? length <= 500 @data(data.health.note)

  list by student
    order by date desc
}

export view PresentDays {
  from AttendanceRecord
  by student
  where healthNote == null
  order by date desc, id desc
  fields id, date, status
}
