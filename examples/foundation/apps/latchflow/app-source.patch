diff --git a/packages/api/src/services/foundation-run.test.ts b/packages/api/src/services/foundation-run.test.ts
new file mode 100644
index 0000000000..e6d3209ba5
--- /dev/null
+++ b/packages/api/src/services/foundation-run.test.ts
@@ -0,0 +1,23 @@
+import { expect, it, vi } from "vitest";
+import { projectStartedRun } from "./foundation-run";
+const room = { id: "room", buildingId: "building" };
+const run = { id: "run", roomId: "room", flowId: "flow", compiledFlowId: "compiled", runnerId: "runner", status: "idle", startedAt: new Date("2026-01-01T00:00:00Z") };
+const compiled = { id: "compiled", flowId: "flow", roomId: "room", compiledJson: '{"nodes":[]}' };
+it("projects the native Run and exact compiled flow without claiming runner acknowledgment", async () => {
+  const recordRun = vi.fn(async () => ({ run: "linked", phase: "Planned" as const }));
+  expect(await projectStartedRun({ recordRun }, "building", "operator", room, run, compiled)).toEqual({ status: "recorded", run: "linked", phase: "Planned" });
+  expect(recordRun).toHaveBeenCalledWith(expect.objectContaining({ runId: "run", runnerId: "runner", status: "idle", compiledJson: compiled.compiledJson, buildingId: "building" }));
+});
+it("retains the durable Run for replay when the projection fails", async () => {
+  const recordRun = vi.fn(async () => { throw new Error("Unavailable"); });
+  expect(await projectStartedRun({ recordRun }, "building", "operator", room, run, compiled)).toEqual({ status: "pending", runId: "run" });
+  expect(recordRun).toHaveBeenCalledTimes(1);
+  expect(await projectStartedRun(undefined, "building", "operator", room, run, compiled)).toEqual({ status: "disabled" });
+});
+it("rejects cross-building, cross-room and substituted compiled flows before projection", async () => {
+  const recordRun = vi.fn(async () => ({ run: "never", phase: "Planned" as const }));
+  await expect(projectStartedRun({ recordRun }, "foreign", "operator", room, run, compiled)).rejects.toThrow();
+  await expect(projectStartedRun({ recordRun }, "building", "operator", room, run, { ...compiled, roomId: "foreign-room" })).rejects.toThrow();
+  await expect(projectStartedRun({ recordRun }, "building", "operator", room, run, { ...compiled, id: "substitute" })).rejects.toThrow();
+  expect(recordRun).not.toHaveBeenCalled();
+});
diff --git a/packages/api/src/services/foundation-run.ts b/packages/api/src/services/foundation-run.ts
new file mode 100644
index 0000000000..9ed1799a83
--- /dev/null
+++ b/packages/api/src/services/foundation-run.ts
@@ -0,0 +1,26 @@
+/** Opt-in observation port. Runner assignment and execution remain owned by LatchFlow. */
+export interface RunFoundationPort {
+  recordRun(event: {
+    buildingId: string; roomId: string; runId: string; operatorId: string;
+    flowId: string; compiledFlowId: string; compiledJson: string;
+    runnerId: string | null; status: "idle" | "running"; startedAt: string;
+  }): Promise<{ run: string; phase: "Planned" | "Running" }>;
+}
+export async function projectStartedRun(
+  port: RunFoundationPort | undefined,
+  buildingId: string,
+  operatorId: string,
+  room: { id: string; buildingId: string },
+  run: { id: string; roomId: string; flowId: string; compiledFlowId: string; runnerId?: string | null; status: string; startedAt: Date },
+  compiled: { id: string; flowId: string; roomId?: string | null; compiledJson: string },
+) {
+  if (!port) return { status: "disabled" as const };
+  if (!buildingId || room.buildingId !== buildingId || run.roomId !== room.id || run.compiledFlowId !== compiled.id || run.flowId !== compiled.flowId || (compiled.roomId != null && compiled.roomId !== room.id) || !["idle", "running"].includes(run.status)) throw new Error("Run projection must match its authorized building, room and compiled flow");
+  try {
+    const linked = await port.recordRun({ buildingId, roomId: room.id, runId: run.id, operatorId, flowId: run.flowId, compiledFlowId: compiled.id, compiledJson: compiled.compiledJson, runnerId: run.runnerId ?? null, status: run.status as "idle" | "running", startedAt: run.startedAt.toISOString() });
+    return { status: "recorded" as const, ...linked };
+  } catch {
+    // Original roomRuns/runEvents remain the replay source. Never start another run.
+    return { status: "pending" as const, runId: run.id };
+  }
+}
