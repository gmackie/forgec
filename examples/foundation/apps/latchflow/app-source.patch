+import { expect, it, vi } from "vitest";
+import { buildingMemberships, compiledFlows, roomRunnerAssignments, roomRuns, rooms, runEvents } from "@latchflow/db";
+vi.mock("../services/experiments", () => ({ assignVariantForRun: vi.fn(async () => null), recordExperimentResult: vi.fn() }));
+vi.mock("../services/video-recording", () => ({ startRunRecording: vi.fn(async () => ({ started: 0 })), stopRunRecording: vi.fn() }));
+vi.mock("../services/product-analytics", () => ({ captureProductEvent: vi.fn(), PRODUCT_ANALYTICS_EVENTS: { runStarted: "run_started" } }));
+import { createRuntimeRouter } from "./runtime";
+function fixture(member = true) {
+  const writes: { table: unknown; value: Record<string, unknown> }[] = [];
+  const db = {
+    select: () => ({ from: (table: unknown) => ({ where: async () => {
+      if (table === rooms) return [{ id: "room", buildingId: "building" }];
+      if (table === buildingMemberships) return member ? [{ role: "operator" }] : [];
+      if (table === compiledFlows) return [{ id: "compiled", roomId: "room", flowId: "flow", compiledJson: '{"nodes":[]}' }];
+      if (table === roomRunnerAssignments) return [{ runnerId: "runner" }];
+      return [];
+    } }) }),
+    insert: (table: unknown) => ({ values: async (value: Record<string, unknown>) => { writes.push({ table, value }); } }),
+    update: () => ({ set: () => ({ where: async () => undefined }) }),
+  };
+  return { db, writes };
+}
+it("startRun calls the injected projection after native Run and event persistence", async () => {
+  const f = fixture();
+  const recordRun = vi.fn(async (event: {runId:string;status:string}) => {
+    expect(f.writes.some(row => row.table === roomRuns && row.value.id === event.runId)).toBe(true);
+    expect(f.writes.some(row => row.table === runEvents && row.value.kind === "run_started")).toBe(true);
+    expect(event.status).toBe("idle");
+    return { run: "foundation-run", phase: "Planned" as const };
+  });
+  const caller = createRuntimeRouter({ recordRun }).createCaller({ db: f.db, userId: "operator" } as never);
+  const result = await caller.startRun({ roomId: "room", compiledFlowId: "compiled" });
+  expect(result.foundation).toEqual({ status: "recorded", run: "foundation-run", phase: "Planned" });
+  expect(recordRun).toHaveBeenCalledTimes(1);
+});
+it("existing building authorization denies before native writes or Foundation projection", async () => {
+  const f = fixture(false), recordRun = vi.fn(async () => ({ run: "never", phase: "Planned" as const }));
+  const caller = createRuntimeRouter({ recordRun }).createCaller({ db: f.db, userId: "outsider" } as never);
+  await expect(caller.startRun({ roomId: "room", compiledFlowId: "compiled" })).rejects.toThrow();
+  expect(f.writes).toHaveLength(0);
+  expect(recordRun).not.toHaveBeenCalled();
+});
