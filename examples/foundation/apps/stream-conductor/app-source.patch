diff --git a/apps/web/src/server/services/foundation-production.test.ts b/apps/web/src/server/services/foundation-production.test.ts
new file mode 100644
index 0000000000..63d44344ed
--- /dev/null
+++ b/apps/web/src/server/services/foundation-production.test.ts
@@ -0,0 +1,22 @@
+import { expect, it, vi } from "vitest";
+import { projectAcknowledgedProduction } from "./foundation-production";
+const session = { id: "session", teamId: "team", broadcastId: "broadcast" };
+const command = { id: "command", sessionId: "session", operatorId: "operator", sequence: 1, type: "cut", status: "acknowledged", payload: null, issuedAt: new Date("2026-01-01T00:00:00Z"), completedAt: new Date("2026-01-01T00:00:01Z") };
+it("projects the durable acknowledged native command with its team and broadcast", async () => {
+  const recordAcknowledgedCommand = vi.fn(async () => ({ command: "foundation-command" }));
+  expect(await projectAcknowledgedProduction({ recordAcknowledgedCommand }, "team", session, command)).toEqual({ status: "recorded", command: "foundation-command" });
+  expect(recordAcknowledgedCommand).toHaveBeenCalledWith(expect.objectContaining({ teamId: "team", broadcastId: "broadcast", sessionId: "session", commandId: "command", type: "cut" }));
+});
+it("does not convert projection outage to an OBS failure or send another command", async () => {
+  const recordAcknowledgedCommand = vi.fn(async () => { throw new Error("Unavailable"); });
+  expect(await projectAcknowledgedProduction({ recordAcknowledgedCommand }, "team", session, command)).toEqual({ status: "pending", commandId: "command" });
+  expect(command.status).toBe("acknowledged");
+  expect(recordAcknowledgedCommand).toHaveBeenCalledTimes(1);
+});
+it("rejects uncertain commands and foreign sessions before invoking Foundation", async () => {
+  const recordAcknowledgedCommand = vi.fn(async () => ({ command: "never" }));
+  await expect(projectAcknowledgedProduction({ recordAcknowledgedCommand }, "foreign", session, command)).rejects.toThrow();
+  await expect(projectAcknowledgedProduction({ recordAcknowledgedCommand }, "team", session, { ...command, status: "uncertain" })).rejects.toThrow();
+  expect(recordAcknowledgedCommand).not.toHaveBeenCalled();
+  expect(await projectAcknowledgedProduction(undefined, "team", session, command)).toEqual({ status: "disabled" });
+});
diff --git a/apps/web/src/server/services/foundation-production.ts b/apps/web/src/server/services/foundation-production.ts
