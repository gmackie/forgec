+import { expect, it, vi } from "vitest";
+vi.mock("../trpc", () => {
+  const procedure = { input: () => procedure, mutation: (handler: unknown) => handler, query: (handler: unknown) => handler };
+  return { router: (routes: unknown) => routes, teamProcedure: procedure, withPermission: () => procedure };
+});
+vi.mock("@/lib/grpc-client", () => ({ switchScene: vi.fn(), syncScenes: vi.fn() }));
+import { createProductionRouter } from "./production";
+it("real command handler invokes opt-in projection after acknowledgment and keeps ack on projection failure", async () => {
+  const writes: Record<string, unknown>[] = [];
+  const session = { id: "session", teamId: "team", broadcastId: null, sequence: 0, previewComposition: null, programComposition: null, needsReconciliation: false, updatedAt: new Date() };
+  const db = {
+    query: { productionSessions: { findFirst: async () => session } },
+    insert: () => ({ values: async (value: Record<string, unknown>) => { writes.push(value); } }),
+    update: () => ({ set: (value: Record<string, unknown>) => { writes.push(value); return { where: () => ({ returning: async () => [{ ...session, ...value }] }) }; } }),
+  };
+  const recordAcknowledgedCommand = vi.fn(async () => {
+    expect(writes.some(write => write.status === "acknowledged")).toBe(true);
+    throw new Error("Foundation unavailable");
+  });
+  const routes = createProductionRouter({ recordAcknowledgedCommand }) as unknown as { command(input: unknown): Promise<{ foundation: unknown; lastCommand: { status: string } }> };
+  const result = await routes.command({ ctx: { db, teamId: "team", userId: "operator" }, input: { command: { id: "native-command", type: "set_preview", composition: { kind: "scene", id: "wide", name: "Wide", requiredInputIds: [], overlayIds: [] } } } });
+  expect(result.foundation).toEqual({ status: "pending", commandId: "native-command" });
+  expect(result.lastCommand.status).toBe("acknowledged");
+  expect(writes.some(write => write.status === "failed" || write.status === "uncertain")).toBe(false);
+});
