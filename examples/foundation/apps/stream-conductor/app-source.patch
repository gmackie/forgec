--- /dev/null
+++ b/apps/web/src/server/services/foundation-production.ts
@@ -0,0 +1,31 @@
+/** An opt-in projection of durable acknowledgments; never a hardware command bus. */
+export interface ProductionFoundationPort {
+  recordAcknowledgedCommand(event: {
+    teamId: string; sessionId: string; broadcastId: string | null;
+    commandId: string; operatorId: string; sequence: number;
+    type: "set_preview" | "cut" | "auto";
+    payload: unknown; issuedAt: string; completedAt: string;
+  }): Promise<{ command: string }>;
+}
+export type ProductionFoundationResult =
+  | { status: "disabled" }
+  | { status: "recorded"; command: string }
+  | { status: "pending"; commandId: string };
+
+/** Runs after productionCommands is acknowledged. Failure cannot change the observed
+ * OBS result. Operators may replay this exact durable row into the port for recovery. */
+export async function projectAcknowledgedProduction(
+  port: ProductionFoundationPort | undefined,
+  teamId: string,
+  session: { id: string; teamId: string; broadcastId: string | null },
+  command: { id: string; sessionId: string; operatorId: string; sequence: number; type: string; status: string; payload: unknown; issuedAt: Date; completedAt: Date | null },
+): Promise<ProductionFoundationResult> {
+  if (!port) return { status: "disabled" };
+  if (session.teamId !== teamId || command.sessionId !== session.id || command.status !== "acknowledged" || !command.completedAt || !["set_preview", "cut", "auto"].includes(command.type)) throw new Error("Only acknowledged commands in the authorized production session can be projected");
+  try {
+    const result = await port.recordAcknowledgedCommand({ teamId, sessionId: session.id, broadcastId: session.broadcastId, commandId: command.id, operatorId: command.operatorId, sequence: command.sequence, type: command.type as "set_preview" | "cut" | "auto", payload: command.payload, issuedAt: command.issuedAt.toISOString(), completedAt: command.completedAt.toISOString() });
+    return { status: "recorded", command: result.command };
+  } catch {
+    return { status: "pending", commandId: command.id };
+  }
+}
