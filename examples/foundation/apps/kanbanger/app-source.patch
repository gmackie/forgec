+import { describe, expect, it, vi } from "vitest";
+vi.mock("@linear-clone/db", () => ({and: (...args: unknown[])=>args,eq:(...args:unknown[])=>args,issues:{id:'issue',teamId:'team',creatorId:'creator',createdAt:'created'},teams:{id:'team',workspaceId:'workspace'}}));
+import { reconcileIssueFoundationIntake } from "../src/services/foundation-intake-service";
+describe("Foundation issue reconciliation", () => {
+  it("reads only the authorized persisted issue and preserves source identity", async () => {
+    const source={issueId:'i',teamId:'t',workspaceId:'w',creatorId:'u',createdAt:new Date('2026-01-01T00:00:00Z')};
+    const where=vi.fn(); const q:any={from:()=>q,innerJoin:()=>q,where:(x:unknown)=>{where(x);return q;},limit:async()=>[source]};
+    const db:any={select:()=>q};const recordIssue=vi.fn().mockResolvedValue({submissionId:'s',issueLinkId:'l'});
+    await expect(reconcileIssueFoundationIntake(db,'w','i',{recordIssue})).resolves.toEqual({submissionId:'s',issueLinkId:'l'});
+    expect(where).toHaveBeenCalledWith([['issue','i'],['workspace','w']]);
+    expect(recordIssue).toHaveBeenCalledWith({...source,createdAt:source.createdAt.toISOString()});
+    await expect(reconcileIssueFoundationIntake(db,'other','i',{recordIssue})).rejects.toThrow('authorized workspace');
+    expect(recordIssue).toHaveBeenCalledTimes(1);
+  });
+});
