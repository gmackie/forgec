@@ -0,0 +1,33 @@
+import { and, eq, issues, teams, type Database } from "@linear-clone/db";
+
+/** Immutable source identity only: mutable title/status are not intake authority. */
+export interface FoundationIssueFact {
+  workspaceId: string;
+  issueId: string;
+  teamId: string;
+  creatorId: string;
+  createdAt: string;
+}
+export interface FoundationIssueIntake {
+  recordIssue(fact: FoundationIssueFact): Promise<{ submissionId: string; issueLinkId: string }>;
+}
+
+/** Opt-in reconciliation of an existing issue, called after normal workspace authorization.
+ * No app writes: failure is retried with this same issue ID, never by repeating createIssue.
+ * workspaceId must come from the authenticated server context, not a request body.
+ */
+export async function reconcileIssueFoundationIntake(
+  db: Database,
+  workspaceId: string,
+  issueId: string,
+  foundation: FoundationIssueIntake,
+): Promise<{ submissionId: string; issueLinkId: string }> {
+  const [source] = await db.select({ issueId: issues.id, teamId: teams.id,
+    workspaceId: teams.workspaceId, creatorId: issues.creatorId, createdAt: issues.createdAt })
+    .from(issues).innerJoin(teams, eq(issues.teamId, teams.id))
+    .where(and(eq(issues.id, issueId), eq(teams.workspaceId, workspaceId))).limit(1);
+  if (!source || source.workspaceId !== workspaceId || source.issueId !== issueId) {
+    throw new Error("Issue not found in authorized workspace");
+  }
+  return foundation.recordIssue({ ...source, createdAt: source.createdAt.toISOString() });
+}
