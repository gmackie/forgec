{
  "name": "forgegraph-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "cargo build --release -p forgegraph-cli && pnpm -r run build",
    "test": "cargo test --workspace && pnpm -r test",
    "typecheck": "pnpm -r exec tsc --noEmit -p tsconfig.json",
    "certify": "pnpm --filter @forgegraph/conformance certify",
    "differential": "pnpm --filter @forgegraph/conformance differential",
    "release:manifest": "node --experimental-strip-types scripts/release-manifest.ts",
    "release:check": "node scripts/check-packaging.mjs",
    "lint:workflows": "node scripts/check-workflows.mjs",
    "release:names": "node scripts/check-crate-names.mjs",
    "foundation:contracts": "node scripts/verify-foundation.mjs --suite contracts --all",
    "foundation:composition": "node scripts/verify-foundation.mjs --suite local --package composition",
    "concept:boundary": "cargo test -p forgegraph-semantic --test concept_boundary --locked"
  },
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "js-yaml": "^4.3.2"
  }
}
