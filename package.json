{
  "name": "forge-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "spike:d1": "pnpm --filter @forge-spike/d1-guarded-batch test",
    "spike:dynamo": "pnpm --filter @forge-spike/dynamodb-conditional-tx test",
    "build": "cargo build -p forge-cli && pnpm -r --filter @forge/runtime --filter @forge/react run build",
    "test": "cargo test --workspace && pnpm -r test",
    "typecheck": "pnpm -r exec tsc --noEmit -p tsconfig.json",
    "certify": "pnpm --filter @forge/conformance certify"
  },
  "license": "Apache-2.0",
  "type": "module"
}
