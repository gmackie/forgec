  EUR = "EUR"
}

export enum InvoiceStatus {
  Open = "open"
  Paid = "paid"
  Void = "void"
}

export shape InvoiceCreate {
  customer_id : text
  amount : text pattern "^[0-9]+\\.[0-9]{2}$"
