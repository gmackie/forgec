  paid_at : datetime?
}

export shape Problem {
  type : text?
  title : text?
  status : integer?
  code : text?
}

export shape GetInvoiceInput {
  invoiceId : text
}

export function CreateInvoice
  @http(POST, "/invoices")
{
  input InvoiceCreate
  output Invoice

  errors {
    PaymentRequired
    Invalid
  }
}

export function GetInvoice
  @http(GET, "/invoices/{invoiceId}")
