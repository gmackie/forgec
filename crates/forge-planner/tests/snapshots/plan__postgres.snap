  "version" BIGINT NOT NULL,
  "created_at" TEXT COLLATE "C" NOT NULL,
  "updated_at" TEXT COLLATE "C" NOT NULL,
  "upload_state" TEXT COLLATE "C" NOT NULL,
  "media_type" TEXT COLLATE "C",
  "byte_count" BIGINT,
  "digest" TEXT COLLATE "C",
  "upload_attempt" BIGINT,
  "staged_media_type" TEXT COLLATE "C",
  "staged_byte_count" BIGINT,
  "content_generation" BIGINT,
  "sealed_generation" TEXT COLLATE "C",
  PRIMARY KEY ("tenant", "id"),
  FOREIGN KEY ("tenant", "order_") REFERENCES order_ ("tenant", "id")
);

CREATE TABLE site_policy (
  "tenant" TEXT COLLATE "C" NOT NULL,
  "id" TEXT COLLATE "C" NOT NULL,
  "site" TEXT COLLATE "C" NOT NULL,
  "max_order_total" BIGINT NOT NULL,
  "requires_approval" BIGINT NOT NULL,
  "version" BIGINT NOT NULL,
  "created_at" TEXT COLLATE "C" NOT NULL,
  "updated_at" TEXT COLLATE "C" NOT NULL,
  "effective_from" TEXT COLLATE "C" NOT NULL,
  "effective_until" TEXT COLLATE "C",
  PRIMARY KEY ("tenant", "id"),
  FOREIGN KEY ("tenant", "site") REFERENCES site ("tenant", "id")
);

