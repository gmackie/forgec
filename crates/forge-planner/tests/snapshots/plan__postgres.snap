  "status" BIGINT NOT NULL,
  "response" TEXT COLLATE "C" NOT NULL,
  "created_at" TEXT COLLATE "C" NOT NULL,
  PRIMARY KEY ("tenant", "operation", "key")
);

CREATE TABLE customer (
  "tenant" TEXT COLLATE "C" NOT NULL,
  "id" TEXT COLLATE "C" NOT NULL,
  "code" TEXT COLLATE "C" NOT NULL,
  "name" TEXT COLLATE "C" NOT NULL,
  "email" TEXT COLLATE "C",
  "tier" TEXT COLLATE "C" NOT NULL,
  "version" BIGINT NOT NULL,
  "created_at" TEXT COLLATE "C" NOT NULL,
  "updated_at" TEXT COLLATE "C" NOT NULL,
  "deleted_at" TEXT COLLATE "C",
  PRIMARY KEY ("tenant", "id")
);

CREATE TABLE department (
  "tenant" TEXT COLLATE "C" NOT NULL,
  "id" TEXT COLLATE "C" NOT NULL,
  "customer" TEXT COLLATE "C" NOT NULL,
  "name" TEXT COLLATE "C" NOT NULL,
  "version" BIGINT NOT NULL,
  "created_at" TEXT COLLATE "C" NOT NULL,
  "updated_at" TEXT COLLATE "C" NOT NULL,
  "parent" TEXT COLLATE "C",
  PRIMARY KEY ("tenant", "id"),
  FOREIGN KEY ("tenant", "customer") REFERENCES customer ("tenant", "id"),
  FOREIGN KEY ("tenant", "parent") REFERENCES department ("tenant", "id")
);

CREATE TABLE site (
  "tenant" TEXT COLLATE "C" NOT NULL,
  "id" TEXT COLLATE "C" NOT NULL,
  "customer" TEXT COLLATE "C" NOT NULL,
  "code" TEXT COLLATE "C" NOT NULL,
  "name" TEXT COLLATE "C" NOT NULL,
  "timezone" TEXT COLLATE "C" NOT NULL,
  "enabled" BIGINT NOT NULL,
  "version" BIGINT NOT NULL,
  "created_at" TEXT COLLATE "C" NOT NULL,
  "updated_at" TEXT COLLATE "C" NOT NULL,
  PRIMARY KEY ("tenant", "id"),
  FOREIGN KEY ("tenant", "customer") REFERENCES customer ("tenant", "id")
);

CREATE TABLE order_ (
  "tenant" TEXT COLLATE "C" NOT NULL,
  "id" TEXT COLLATE "C" NOT NULL,
  "customer" TEXT COLLATE "C" NOT NULL,
  "site" TEXT COLLATE "C" NOT NULL,
  "subtotal" BIGINT NOT NULL,
  "tax" BIGINT NOT NULL,
  "requested_on" TEXT COLLATE "C" NOT NULL,
  "notes" TEXT COLLATE "C",
  "version" BIGINT NOT NULL,
  "created_at" TEXT COLLATE "C" NOT NULL,
  "updated_at" TEXT COLLATE "C" NOT NULL,
  "status" TEXT COLLATE "C" NOT NULL,
  PRIMARY KEY ("tenant", "id"),
  FOREIGN KEY ("tenant", "customer") REFERENCES customer ("tenant", "id"),
  FOREIGN KEY ("tenant", "site") REFERENCES site ("tenant", "id"),
  CONSTRAINT order__status CHECK (status IN ('Draft', 'Completed', 'Cancelled', 'Submitted', 'Approved'))
);

CREATE TABLE order_document (
  "tenant" TEXT COLLATE "C" NOT NULL,
  "id" TEXT COLLATE "C" NOT NULL,
  "order_" TEXT COLLATE "C" NOT NULL,
  "kind" TEXT COLLATE "C" NOT NULL,
