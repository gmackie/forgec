          "result": {
            "enum": [
              null
            ],
            "nullable": true,
            "type": "object",
            "x-fern-enum": {
              "null": {
                "name": "V_null"
              }
            }
          },
          "success": {
            "description": "Whether the API call was successful.",
            "enum": [
              false
            ],
