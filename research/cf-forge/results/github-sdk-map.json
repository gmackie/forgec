{
  "issues/create": {
    "accessor": [
      "issues"
    ],
    "method": "create",
    "httpMethod": "POST",
    "path": "/repos/{owner}/{repo}/issues",
    "requestType": "IssuesCreateRequest",
    "responseType": "Issue",
    "requiredRequestProperties": [
      "owner",
      "repo",
      "title"
    ]
  },
  "issues/list-for-repo": {
    "accessor": [
      "issues"
    ],
    "method": "listForRepo",
    "httpMethod": "GET",
    "path": "/repos/{owner}/{repo}/issues",
    "requestType": "IssuesListForRepoRequest",
    "requiredRequestProperties": [
      "owner",
      "repo"
    ]
  }
}
