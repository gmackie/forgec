{
  "name": "forge-lab-build-service",
  "main": "generated/worker.mjs",
  "no_bundle": true,
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }],
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "forge-lab-build-service-blobs" }]
}
