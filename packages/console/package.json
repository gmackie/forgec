{
  "name": "@forgegraph/console",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-editor.mjs && vite --host 127.0.0.1",
    "build": "node scripts/build-editor.mjs && vite build && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/server.mjs",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "studio:generate": "node scripts/build-studio.mjs",
    "studio:check": "node scripts/build-studio.mjs --check"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.14.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@forgegraph/react": "workspace:*",
    "@forgegraph/registry": "workspace:*",
    "@forgegraph/runtime": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@phosphor-icons/react": "^2.1.10",
    "effect": "4.0.0-rc.116",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250920.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.27.0",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.83.0"
  }
}
