{
  "name": "@forgegraph/console",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
