    "@forgegraph/registry": "workspace:*",
    "@forgegraph/runtime": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "effect": "4.0.0-rc.116",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250920.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.27.0",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.83.0"
