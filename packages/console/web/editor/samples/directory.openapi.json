{
  "openapi": "3.1.0",
  "info": { "title": "Support Directory", "version": "1.0.0" },
  "servers": [{ "url": "https://directory.vendor.example/v1" }],
  "paths": {
    "/contacts/{contactId}": {
      "get": {
        "operationId": "getContact",
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Contact",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "email"],
                  "properties": {
                    "id": { "type": "string" },
                    "email": { "type": "string", "format": "email" },
                    "external_id": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
