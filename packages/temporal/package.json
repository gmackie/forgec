{
  "name": "@forgegraph/temporal",
  "version": "0.3.0",
  "description": "Temporal-backed WorkflowDriver for the self-hosted-full profile (FORGE-076): Temporal keeps the durable timer/signal state; the Forge engine keeps the instance semantics.",
  "license": "Apache-2.0",
  "author": "ForgeGraph contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmackie/forgec.git",
    "directory": "packages/temporal"
  },
  "homepage": "https://github.com/gmackie/forgec#readme",
  "bugs": {
    "url": "https://github.com/gmackie/forgec/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "source": "./src/workflows.ts",
      "import": "./dist/workflows.js",
      "default": "./dist/workflows.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@forgegraph/runtime": "workspace:*",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "effect": "4.0.0-rc.116"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pg": "^8.23.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "forgegraph": {
    "stability": "experimental"
  }
}
