{
  "name": "@forgegraph/registry",
  "version": "0.3.0",
  "description": "Immutable artifact publication, derived catalog, confidential access and federation, deployment inventory, signed snapshots (M15).",
  "license": "Apache-2.0",
  "author": "ForgeGraph contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmackie/forgec.git",
    "directory": "packages/registry"
  },
  "homepage": "https://github.com/gmackie/forgec#readme",
  "bugs": {
    "url": "https://github.com/gmackie/forgec/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts.d.ts",
      "source": "./src/artifacts.ts",
      "import": "./dist/artifacts.js",
      "default": "./dist/artifacts.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "source": "./src/catalog.ts",
      "import": "./dist/catalog.js",
      "default": "./dist/catalog.js"
    },
    "./security": {
      "types": "./dist/security.d.ts",
      "source": "./src/security.ts",
      "import": "./dist/security.js",
      "default": "./dist/security.js"
    },
    "./deployments": {
      "types": "./dist/deployments.d.ts",
      "source": "./src/deployments.ts",
      "import": "./dist/deployments.js",
      "default": "./dist/deployments.js"
    },
    "./grants": {
      "types": "./dist/grants.d.ts",
      "source": "./src/grants.ts",
      "import": "./dist/grants.js",
      "default": "./dist/grants.js"
    },
    "./approval-bot": {
      "types": "./dist/approval-bot.d.ts",
      "source": "./src/approval-bot.ts",
      "import": "./dist/approval-bot.js",
      "default": "./dist/approval-bot.js"
    },
    "./grant-publication": {
      "types": "./dist/grant-publication.d.ts",
      "source": "./src/grant-publication.ts",
      "import": "./dist/grant-publication.js",
      "default": "./dist/grant-publication.js"
    },
    "./snapshots": {
      "types": "./dist/snapshots.d.ts",
      "source": "./src/snapshots.ts",
      "import": "./dist/snapshots.js",
      "default": "./dist/snapshots.js"
    },
    "./evidence": {
      "types": "./dist/evidence.d.ts",
      "source": "./src/evidence.ts",
      "import": "./dist/evidence.js",
      "default": "./dist/evidence.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@forgegraph/runtime": "workspace:*",
    "@forgegraph/interfaces": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "effect": "4.0.0-rc.116",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "forgegraph": {
    "stability": "experimental"
  }
}
