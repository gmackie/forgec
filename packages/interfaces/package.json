{
  "name": "@forgegraph/interfaces",
  "version": "0.4.0",
  "description": "Non-Effect interfaces over one operation model: RPC bindings, MCP server, generic API CLI, dashboards.",
  "license": "Apache-2.0",
  "author": "ForgeGraph contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmackie/forgec.git",
    "directory": "packages/interfaces"
  },
  "homepage": "https://github.com/gmackie/forgec#readme",
  "bugs": {
    "url": "https://github.com/gmackie/forgec/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "bin",
    "sdk-python",
    "sdk-go"
  ],
  "bin": {
    "forge-api": "./bin/forge-api.mjs"
  },
  "exports": {
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "source": "./src/rpc.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "source": "./src/mcp.ts",
      "import": "./dist/mcp.js",
      "default": "./dist/mcp.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "source": "./src/cli.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./dashboards": {
      "types": "./dist/dashboards.d.ts",
      "source": "./src/dashboards.ts",
      "import": "./dist/dashboards.js",
      "default": "./dist/dashboards.js"
    },
    "./graphql": {
      "types": "./dist/graphql.d.ts",
      "source": "./src/graphql.ts",
      "import": "./dist/graphql.js",
      "default": "./dist/graphql.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@forgegraph/runtime": "workspace:*",
    "graphql": "^16.14.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "effect": "4.0.0-rc.116",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "forgegraph": {
    "stability": "stable-candidate"
  }
}
