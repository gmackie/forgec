{
  "name": "@forgegraph/react",
  "version": "0.4.0",
  "description": "React workspace bindings for a ForgeGraph app bundle: typed hooks over the generated client.",
  "license": "Apache-2.0",
  "author": "ForgeGraph contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmackie/forgec.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/gmackie/forgec#readme",
  "bugs": {
    "url": "https://github.com/gmackie/forgec/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.tsx"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@forgegraph/runtime": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "effect": "4.0.0-rc.116",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0",
    "@testing-library/jest-dom": "^6.6.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "forgegraph": {
    "stability": "stable-candidate"
  }
}
