{
  "name": "@forgegraph/release-gates",
  "version": "0.5.0",
  "description": "Governed previews and staged release gates (FORGE-071): sanitized preview profiles, minimum-evidence SLO gates, signed acknowledgments, retain-by-default cleanup.",
  "license": "Apache-2.0",
  "author": "ForgeGraph contributors",
  "repository": {
    "type": "git",
    "url": "git+https://git.forgegraf.com/gmackie/forge.git",
    "directory": "packages/release-gates"
  },
  "homepage": "https://git.forgegraf.com/gmackie/forge",
  "bugs": {
    "url": "https://git.forgegraf.com/gmackie/forge/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@forgegraph/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "forgegraph": {
    "stability": "experimental"
  }
}
