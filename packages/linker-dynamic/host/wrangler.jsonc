// Local only (wrangler dev --local). Same bindings as examples/acme/deploy/cloudflare/wrangler.jsonc,
// plus the Worker Loader and the unit store, minus the realtime Durable Object (not linked by T4).
// Secrets come from --var: CURSOR_SECRET, LINKER_ADMIN_TOKEN; LINKER_UNCOVERED=runtime enables the
// reported whole-app fallback for surfaces the manifest does not cover.
{
  "name": "forge-acme-linker-dynamic",
  "main": "acme.ts",
  "compatibility_date": "2026-09-25",
  "worker_loaders": [{ "binding": "LOADER" }],
  "vars": { "FORGE_AUTH": "dev-headers", "FORGE_CORS": "http://localhost:5173,https://forge-acme-workspace.example.workers.dev" },
  "r2_buckets": [
    { "binding": "UNITS", "bucket_name": "forge-units" },
    { "binding": "BLOBS", "bucket_name": "forge-acme-blobs" }
  ],
  "triggers": { "crons": ["*/5 * * * *", "0 3 * * *"] },
  "workflows": [{ "name": "forge-acme-commerce-process-order", "binding": "WF_PROCESS_ORDER", "class_name": "ProcessOrderWorkflow" }],
  "queues": {
    "producers": [{ "binding": "Q_FULFILL_ORDER", "queue": "forge-acme-commerce-fulfill-order" }],
    "consumers": [{ "queue": "forge-acme-commerce-fulfill-order", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "forge-acme-commerce-dlq" }]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "forge-acme", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../../examples/acme/migrations/d1" }
  ]
}
