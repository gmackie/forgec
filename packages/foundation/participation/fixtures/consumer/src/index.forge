import party
import participation
resource Team
  @tenant
  @versioned
{
  id : id
  members : participation.ParticipationSet @immutable @unique
}
resource Classroom
  @tenant
  @versioned
{
  id : id
  enrollment : participation.ParticipationSet @immutable @unique
}
resource ReviewBoard
  @tenant
  @versioned
{
  id : id
  reviewers : participation.ParticipationSet @immutable @unique
}
resource OrganizationParty
  @tenant
  @appendOnly
{
  id : id
  organizationCode : text length 1..128 @unique
  party : party.Party @unique
}
