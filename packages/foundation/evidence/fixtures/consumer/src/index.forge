import evidence

resource DeploymentVerification
  @tenant
  @appendOnly
{
  id : id
  evidence : evidence.EvidenceBundle
  commit : text length 40..40
}
resource ManufacturingInspection
  @tenant
  @appendOnly
{
  id : id
  evidence : evidence.EvidenceBundle
  lot : text length 1..100
}
resource AgentReview
  @tenant
  @appendOnly
{
  id : id
  evidence : evidence.EvidenceBundle
  agent : text length 1..100
}
resource MeasurementEvidence
  @tenant
  @appendOnly
{
  id : id
  item : evidence.EvidenceItem @unique
  measuredValue : decimal<3>
  unit : text length 1..30
}
