import opportunity
export resource SalesPursuit @tenant @appendOnly {
 id : id
 pursuit : opportunity.Opportunity
 product : text length 1..200
}
export resource PartnershipPursuit @tenant @appendOnly {
 id : id
 pursuit : opportunity.Opportunity
 sharedOutcome : text length 1..200
}
export resource GrantPursuit @tenant @appendOnly {
 id : id
 pursuit : opportunity.Opportunity
 program : text length 1..200
}
export resource ProcurementPursuit @tenant @appendOnly {
 id : id
 pursuit : opportunity.Opportunity
 requirement : text length 1..200
}
