type GitCommit = text length 40..64 pattern "^([0-9a-f]{40}|[0-9a-f]{64})$"
type BuildHash = text length 64..64 pattern "^[0-9a-f]{64}$"
type ManifestDigest = text length 64..64 pattern "^[0-9a-f]{64}$"

export resource Repository @tenant @versioned @crud("/v1/specification/repositories") {
  id : id
  key : text length 1..128 @immutable @unique
  provider : text length 1..64
  locator : text length 1..2048
  find by key
}

export resource SpecificationPin @tenant @appendOnly @crud("/v1/specification/pins") {
  id : id
  repository : Repository
  anchor : text length 1..128
  revision : GitCommit
  unique repository, anchor, revision
  find by repository, anchor, revision
  list by repository, anchor
}

export resource Realization @tenant @appendOnly @crud("/v1/specification/realizations") {
  id : id
  pin : SpecificationPin
  buildHash : BuildHash
  manifestDigest : ManifestDigest
  unique pin, buildHash, manifestDigest
  list by pin
}
